@keyframes highlightTextChange {
  0%   { color: #ffffff; transform: scale(1,1); transform-origin: 50% 100%;}
 10%   { color: #24ffff; transform: scale(1.05,1.05); transform-origin: 50% 100%;}
 20%   { color: #FFFFFF; transform: scale(1,1); transform-origin: 50% 100%;}
 30%   { color: #24ffff; transform: scale(1.05,1.05); transform-origin: 50% 100%;}
 40%   { color: #FFFFFF; transform: scale(1,1); transform-origin: 50% 100%;}
 50%   { color: #24ffff; transform: scale(1.05,1.05); transform-origin: 50% 100%;}
 60%   { color: #FFFFFF; transform: scale(1,1); transform-origin: 50% 100%;}
 70%   { color: #24ffff; transform: scale(1.05,1.05); transform-origin: 50% 100%;}
 80%   { color: #FFFFFF; transform: scale(1,1); transform-origin: 50% 100%;}
 90%   { color: #24ffff; transform: scale(1.1,1.1); transform-origin: 50% 100%;}
 100%  { color: #FFFFFF; transform: scale(1,1); transform-origin: 50% 100%;}
}
.wheelPrompt {
  width: initial;
  height: initial;

  padding: 0;
  margin: 0 0.5vh;
}
.standaloneTextPrompt
{
  width: initial;
  height: initial;

  min-width: 4vh;
  text-align: center;

  font-weight: bold;
  color: #CFF76D;

  padding: 0 0.5vh 0.2vh;

  background-color: #031E2B;
  border: 0.25vh solid #628891;
  border-radius: 0.5vh;
}
.POITextPrompt
{
    height: 1.6em;

    display: block;
    font-size: 0.75em;

    font-weight: bold;
    color: #CFF76D;

    padding: 0px 0.39em 0.125em;
    margin-left: 0.1em;
    margin-right: 0.1em;

    min-width: 1.5em;
    text-align: center;

    border-radius: 0.25em;
    background-color: #031E2B;
    border: 0.10em solid rgba(137, 137, 137, 0.8);
}
