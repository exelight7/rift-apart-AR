  {
    "index": 16,
    "key": "ACTIVITY_CARD_PLANET_ARDOLIS",
    "source_sha256": "3d6c46c9ad70e379b85c7ca4fbcaefc3bb4f2ce4d32596ddc157c091fcbbb8d2",
    "before": "أردوليس",
    "after": "أردوليس",
    "decision": "keep"
  },
  {
    "index": 17,
    "key": "ACTIVITY_CARD_PLANET_ARDOLIS_DESC",
    "source_sha256": "9eb4db1d00a06e85b008ca3eb32c37cc5d3caa7602554f7c591ae39777e6b664",
    "before": "قاعدة القراصنة الرئيسية — حصن —<br>التي لم تعد سرا للروبوتات التي<br>تطمح إلى حياة من المغامرة والحرية<br>والأفعال الملتبسة أخلاقيا.",
    "after": "قاعدة القراصنة الرئيسية، التي ليست<br>سرية تمامًا، معقل للروبوتات<br>الراغبة في حياة من المغامرة<br>والحرية والأعمال الملتبسة<br>أخلاقيًا.",
    "decision": "rewrite"
  },
  {
    "index": 18,
    "key": "ACTIVITY_CARD_PLANET_BLIZAR",
    "source_sha256": "82d4f231ea31dad75f80991cb108652dfe02efc37553d096965f520f15faf8d2",
    "before": "بليزار برايم",
    "after": "بليزار برايم",
    "decision": "keep"
  },
  {
    "index": 19,
    "key": "ACTIVITY_CARD_PLANET_BLIZAR_DESC",
    "source_sha256": "2e55a59406262aabcbcc9550dccd009a6c4b68024839d96f60153e970ca1e5f3",
    "before": "تشتهر بليزار برايم بجمالها<br>ووظيفتها على حد سواء؛ فهي موطن<br>لعمليات تعدين توفر المصدر الرئيسي<br>للمجرة من بلورات البليزون، ومن<br>كوارتز المرحلة عند الضرورة القصوى.",
    "after": "تشتهر بليزار برايم بجمالها<br>وأهميتها العملية. تضم مناجم تزود<br>المجرة بمعظم بلورات البليزون،<br>وبكوارتز الطور عند الضرورة القصوى.",
    "decision": "rewrite"
  },
  {
    "index": 20,
    "key": "ACTIVITY_CARD_PLANET_CORDELION",
    "source_sha256": "3306fc18ee62af4d30746321a1a7ae62c3fd9dfe280ce3756756b32126f7ffd8",
    "before": "كوردليون",
    "after": "كوردليون",
    "decision": "keep"
  },
  {
    "index": 21,
    "key": "ACTIVITY_CARD_PLANET_CORDELION_DESC",
    "source_sha256": "64ef99b6c662ccd9f25b73e9adfa6dcbc7f695d8c16c39e25d7866e39928a752",
    "before": "لا تسكن محيطات كوردليون الممتدة<br>بلا ضفاف مخلوقات جميلة وخطيرة<br>فحسب، بل فيها محطة كيدارو السرية<br>المحصنة، حيث تكمن في أعماقها مصنع<br>الروبيون التجريبية للإمبراطور.",
    "after": "تضم محيطات كوردليون الشاسعة<br>مخلوقات كثيرة جميلة وخطيرة، فضلًا<br>عن محطة كيدارو السرية شديدة<br>التحصين، حيث يختبئ مسبك الروبيون<br>التجريبي الخاص بالإمبراطور في<br>الأعماق.",
    "decision": "rewrite"
  },
  {
    "index": 22,
    "key": "ACTIVITY_CARD_PLANET_CORSON",
    "source_sha256": "0a1b2960edab311f5dac3b41dbccb467b10096b63a912d2d8da18b3880c1aa03",
    "before": "كورسون الخامس",
    "after": "كورسون الخامس",
    "decision": "keep"
  },
  {
    "index": 23,
    "key": "ACTIVITY_CARD_PLANET_CORSON_DESC",
    "source_sha256": "74031864ffe0a89fd580bab3841829f66e77628a61746afd5e54ed9ae69a91c7",
    "before": "،كوكب متنوع نابض بالحياة يعد من<br>أسعد كواكب قطاعه؛ ،فبقدر ما هو<br>مشمس ودود تبقى عاصمته ميغالوبوليس<br>الوجهة السياحية الأشهر في الكون<br>بأسره!",
    "after": "كوكب متنوع يعج بالحياة، ويعد من<br>أسعد كواكب قطاعه. أما عاصمته<br>ميغالوبوليس، المشمسة والودودة، فما<br>تزال الوجهة السياحية الأشهر في<br>الكون بأسره!",
    "decision": "rewrite"
  },
  {
    "index": 24,
    "key": "ACTIVITY_CARD_PLANET_NEFCITY",
    "source_sha256": "0a1b2960edab311f5dac3b41dbccb467b10096b63a912d2d8da18b3880c1aa03",
    "before": "كورسون الخامس",
    "after": "كورسون الخامس",
    "decision": "keep"
  },
  {
    "index": 25,
    "key": "ACTIVITY_CARD_PLANET_NEFCITY_DESC",
    "source_sha256": "1bfa7931be8aa7a2ace49b6f93fd29939549773620d7dfb7bf47d9a0c77d22b1",
    "before": "كوكب عابس ممطر يخيم عليه وهج<br>النيون، صيغ على ذوق الإمبراطور<br>نفسه الذي لا تشوبه شائبة. وعاصمته<br>مدينة نيفاريوس من أكثر مقاصد الكون<br>زيارة لدى من يحالفهم الحظ فيسمح<br>لهم بدخول الغلاف الجوي.",
    "after": "يكتنف كورسون الخامس الظلام والمطر<br>وأضواء النيون، وقد صمم على ذوق<br>الإمبراطور نفسه الذي لا تشوبه<br>شائبة. وعاصمته، مدينة نيفاريوس، من<br>أكثر وجهات الكون زيارة لدى<br>المحظوظين الذين يسمح لهم بدخول<br>غلافه الجوي.",
    "decision": "rewrite"
  },
  {
    "index": 26,
    "key": "ACTIVITY_CARD_PLANET_SARGASSO",
    "source_sha256": "625fa000810d7baa028bbe69b6b3232cca6a0e226487becd6f0043b3bcc897e4",
    "before": "سارجاسو",
    "after": "سارجاسو",
    "decision": "keep"
  },
  {
    "index": 27,
    "key": "ACTIVITY_CARD_PLANET_SARGASSO_DESC",
    "source_sha256": "1c529f4361cd3fd4d68abea2951997b75a4cb9d3788255a162612e4215175108",
    "before": "سارجاسو؛ الأرض التي نسيها الزمن.<br>أو بالأحرى، الأرض التي ،ألقى<br>الإمبراطور نظرة عليها فلم يستطع أن<br>ينساها بسرعة كافية. أرض تغمرها<br>،المستنقعات الحمضية ،وتفعمها<br>الوحوش البدائية وتزحف فيها<br>الحشرات... الكثير الكثير من<br>الحشرات.",
    "after": "سارجاسو، الأرض التي نسيها الزمن.<br>أو بالأحرى، الأرض التي ألقى عليها<br>الإمبراطور نظرة واحدة ثم تمنى<br>نسيانها فورًا. تملؤها المستنقعات<br>الحمضية والوحوش البدائية<br>والحشرات... حشرات كثيرة جدًا.",
    "decision": "rewrite"
  },
  {
    "index": 28,
    "key": "ACTIVITY_CARD_PLANET_SAVALI",
    "source_sha256": "4fea25988e7773351c678d21f59761c97c810bd68f400e0f077b88f3fa134e0d",
    "before": "سافالي",
    "after": "سافالي",
    "decision": "keep"
  },
  {
    "index": 29,
    "key": "ACTIVITY_CARD_PLANET_SAVALI_DESC",
    "source_sha256": "44727e6c97d3a34585c89b4a4f9f8578d5e9ec79e3105c2a53a41fbd19893dbb",
    "before": "كوكب هادئ يتوارى على أطراف المجرة،<br>يسكنه نساك يأوون إلى أنقاض المواقع<br>الحامية اللومباكسات القديمة<br>المتناثرة على سطحه.",
    "after": "كوكب مسالم عند أطراف المجرة، يسكن<br>رهبانه أطلال مواقع اللومباكس<br>القديمة المتناثرة على سطحه.",
    "decision": "rewrite"
  },
  {
    "index": 30,
    "key": "ACTIVITY_CARD_PLANET_TORREN",
    "source_sha256": "b2d075d2a692a9bfd9de92ee29f8d4b7f1b8f491e3f4bdfe163c24dd8a83f4d6",
    "before": "تورين الرابع",
    "after": "تورين الرابع",
    "decision": "keep"
  },
  {
    "index": 31,
    "key": "ACTIVITY_CARD_PLANET_TORREN_DESC",
    "source_sha256": "f35897bc4c261d9a1c9588a3f74e3326e15a8194f60941bc888ebc514d533eec",
    "before": "تورين الرابع، بقدر ما هو جاف فهو<br>جبلي، موطن لآلاف الفولارد، وأكبر<br>مقلب خردة في المجرة بأسرها.",
    "after": "تورين الرابع كوكب جاف تكسوه<br>الجبال، وموطن لأعداد لا تحصى من<br>الفولارد ولأكبر ساحة خردة في<br>المجرة.",
    "decision": "rewrite"
  },
  {
    "index": 32,
    "key": "ACTIVITY_CARD_PLANET_VICERON",
    "source_sha256": "4290b374aac71e1c65499e43565d520a2463fb1881061581c8d92b46ce44b650",
    "before": "فيسرون",
    "after": "فيسرون",
    "decision": "keep"
  },
  {
    "index": 33,
    "key": "ACTIVITY_CARD_PLANET_VICERON_DESC",
    "source_sha256": "58fe66dea86765542af2aeb14bfe78d1bf8d0270cea64ff18ae97109e27e8ad2",
    "before": "تشتهر فيسرون بعواصفها القاتلة التي<br>لا تكاد تهدأ ومياهها الخادعة،<br>لكنها الأشهر بوصفها موطنا لسجن<br>زردوم — الوجهة الأخيرة لكل من يجرؤ<br>على تحدي الإمبراطور.",
    "after": "رغم شهرة فيسرون بعواصفه القاتلة<br>الدائمة ومياهه الغادرة، فإن أشهر<br>معالمه سجن زردوم، المحطة الأخيرة<br>لكل من يجرؤ على معارضة الإمبراطور.",
    "decision": "rewrite"
  },
  {
