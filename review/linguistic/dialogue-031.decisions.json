  "changes": {
    "23172": "أبلي بلاء رائعًا!",
    "23201": "تراجع في المستوى، كالعادة.",
    "23219": "سيلتهمك على الإفطار!",
    "23220": "اذهب والتهمهم!",
    "23235": "اللومباكس يطلق النار عشوائيًّا!",
    "23278": [
      "هي؟",
      "أمم، ألسنا نبحث عن «ذكر»، يا صاح؟"
    ],
    "23280": "تعاون بتعاون، يا صاح. أخبرنا أين هو ولن نسحقك!",
    "23283": [
      "حسنًا، ربما أدعك تطقطق ظهري.",
      "قليلًا."
    ],
    "23284": "مـ... مـ... مهلًا، لا. لست مستعدًّا.",
    "23288": "ليست هذه الطريقة التي أريد أن أموت بها، يا صاح.",
    "23290": [
      "نعم،",
      "ماذا الآن؟"
    ],
    "23291": [
      "لا خيار أمامنا. علينا العثور على اللومباكس. أمم،",
      "نسختي اللومباكس."
    ],
    "23297": [
      "يا رفاق، لا يهمني إن كانت مخفوقات بروتين بلارغية،",
      "اللومباكس أولويتنا!"
    ],
    "23304": [
      "ما رأيك بهذا؟",
      "سنكون مدينين لك بمعروف كبير!"
    ],
    "23307": [
      "هل يمكنني...",
      "أن أركب بعدك، يا صاح؟"
    ],
    "23308": "أنا جاد! أنا متحمس للغاية!",
    "23315": "هيا، يا رفاق، طوقوه!",
    "23324": "انظروا إلى القوة التي أضغط بها على هذا الزناد!",
    "23339": "إنهم يطلقون النار!",
    "23343": "هذا يفوق الاحتمال!",
    "23350": "لا أريد أن أصاب بقنبلة!",
    "23353": "قنابل؟! هذا غير مقبول إطلاقًا!",
    "23367": "سيبعثر ذلك فراءك!",
    "23374": "كان ينبغي ألا تفوت تمرين الساقين!",
    "23405": "يا له من تشتت طلقات قاتل!",
    "23409": "تقدم للقتال أو انسحب!",
    "23410": "ستتعرض للسحق!",
    "23412": "ذق السحق!",
    "23415": "لحسن الحظ، أجريت تمارين الإطالة!",
    "23416": "أحرقت قميصي المفضل، يا صاح!",
    "23421": "عضلاتي تـ... تجمدت!",
    "23422": "أشعر بقضمة الصقيع بالفعل.",
    "23427": "ما هذه المادة اللزجة؟!",
    "23428": "ألقيت قنبلة!",
    "23429": "انطلقت القنابل! هه.",
    "23445": "لكنني لست مستعدًّا للتهدئة بعد التمرين!",
    "23446": "كل هذا الانتظار يقضي على نمو عضلاتي.",
    "23456": "تفرقوا، يا رفاق!",
    "23460": "واو! ماذا كان ذلك؟!",
    "23462": "سأتقاضى أجرًا على هذا.",
    "23463": [
      "اكتمل العقد،",
      "يا صاح."
    ],
    "23492": "لنتعانق!",
    "23496": "تعرف أن هذا سيؤلم، أليس كذلك؟!",
    "23509": "ذخيرتك قليلة، يا صاحب الفرو؟",
    "23515": "هذا يفاقم... حساسيتي.",
    "23516": "لماذا لا أستطيع... يا رجل، هل أنا نبتة؟!",
    "23520": "ماذا فعلت بي؟!",
    "23521": "لماذااا؟!",
    "23534": "آه! آلة البينبول الغبية هذه!",
    "23536": "افتكي به، يا فتاة!",
    "23537": "هيا، نالي منه، يا أميرة!",
    "23538": "جرْوي الصغير سيسحقك!",
    "23550": "أتسمي تلك رمية؟!",
    "23570": "نصيحة محترف: لا تبتل!",
    "23571": "لم يحن وقت التهدئة بعد التمرين!",
    "23578": "تفرقوا!",
    "23581": "مؤجج الحروب في الميدان، يا رفاق!",
    "23584": "احذروا مؤجج الحروب الذي يحمله اللومباكس!",
    "23588": "أين ذهبوا؟!",
    "23597": "هناك لومباكس آخر؟ أخبرينا أين صديقك، يا أختاه!",
    "23599": "من يهتم؟! أطلقوا النار عليه!",
    "23603": "ليس بجوعي أنا! أريد تلك الفاكهة!",
    "23608": [
      "مهلًا، لقد قررنا التوقف عن قتلك.",
      "هلا أخرجتنا؟"
    ],
    "23612": "دخول كرات الفرو ممنوع... أمزح، نحن على وفاق.",
    "23623": "أوه، لديهم عصائر مخفوقة! ها، لحسن الحظ، أحمل دائمًا شفاطة قابلة لإعادة الاستخدام!",
    "23624": [
      "أوه، وجدت أخيرًا مكانًا بجاذبية مناسبة لرفع الأثقال،",
      "وليس لديهم حتى مقعد للتمرين..."
    ],
    "23625": "سأفعلها، سأصلح حالي. لا عودة إلى زوردوم بعد اليوم!",
    "23627": "العضلات قبل القطارات!",
    "23629": "نالوا منه، أيتها الكلاب الآلية!",
    "23635": "نالوا منه، أيتها الكلاب الآلية!",
    "23644": "اللومباكس في مرمى تصويبي!",
    "23661": "إنها على وشك التفرع!",
    "23662": "لا، لن ترتد قذائفك علي، يا لومباكس!",
    "23668": "أهذه النصال مسننة؟!",
    "23694": "ستسقط!",
    "23695": "يا رجل، أنا بارع!",
    "23699": "إصابة، يا رفاق!",
    "23721": "اللومباكس يقذف روبوتات صغيرة!",
    "23735": [
