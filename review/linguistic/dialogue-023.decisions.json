  "changes": {
    "17086": [
      "يا لوامس، يا جميلة...",
      "ما الذي يقفى مع «لوامس»؟ ما الذي يقفى مع «لوامس»؟!"
    ],
    "17096": "نطلق النار على ابن اليابسة.",
    "17098": "لن يحالفك الحظ نفسه معي!",
    "17105": "توقف عن الحركة، أيها الوغد!",
    "17114": "إنها على وشك التفرع!",
    "17116": "كم طلقة لديك، يا لومباكس؟!",
    "17118": "اخفضوا رؤوسكم، يا رفاقي!",
    "17134": "ستحتاج إلى أكثر من ذلك لتغرقني، يا صاح!",
    "17135": "أتعرض لإطلاق النار!",
    "17141": [
      "ترتجف...",
      "عظامي..."
    ],
    "17149": "سددت ضربة!",
    "17167": "قفاز جميل، يا لومباكس!",
    "17168": "اضربوا هذه الروبوتات بالسيوف!",
    "17177": "انظر إلى تشتت طلقات ذلك الشيء!",
    "17178": "ذلك الوغد يحمل إنفورسر!",
    "17182": "يارر! أمطروهم بالنيران!",
    "17184": "لست جديرًا حتى بمسح أسطح سفننا!",
    "17186": "تورطت فيما يفوق قدرتك، يا صديقي!",
    "17190": [
      "تروسي",
      "تـ... تجمدت!"
    ],
    "17195": "جلب اللومباكس تعزيزات!",
    "17196": "لقد أصبت!",
    "17217": "لا شيء يضاهي الإبحار بين المنظومات السبع، والنجوم وحدها ترشدك.",
    "17219": "سيفي المقوس يحتاج إلى شحذ. ذلك الشيء الملعون أثلم من أسنان تروغلوصور!",
    "17220": "لا أجرؤ على التباهي، لكنني أعتقد أن الحظ في صفي اليوم.",
    "17221": "أشفق على من لا يستطيعون الاستمتاع بحياة القراصنة. لا بأس، ستكون حصتي أكبر.",
    "17231": "مصادم النيجاترون!",
    "17232": "الغروغ للجميع!",
    "17233": "انهبوا واسلبوا!",
    "17234": "من أجل القبطان!",
    "17235": "مسحنا بك سطح السفينة!",
    "17274": "لا يمكنك الاختباء إلى الأبد!",
    "17297": "لا يمكنك إطلاق النار بلا ذخيرة، أيها الأحمق!",
    "17298": [
      "اقطعوا الأغصان،",
      "وأخرجوني من هنا!"
    ],
    "17301": "أفقد توازني!",
    "17317": "ليوقفهم أحد!",
    "17321": "رينو على سطح السفينة!",
    "17322": "جرذ السفينة في مرمى تصويبي!",
    "17324": "وغد في مرمى تصويبي!",
    "17361": "تحركوا، أيها الحثالة!",
    "17365": "احتموا!",
    "17366": "احذروا مؤجج الحروب!",
    "17372": "فقدت فريستنا!",
    "17377": "لننهب بجنون ونعث فسادًا، فالمصلح أوشك على الهلاك!",
    "17379": [
      "بعد خروج المصلح من الخدمة،",
      "أصبحت هذه البلدة لنا!"
    ],
    "17380": "رائحة الخردة تلسع أنفي! لكن الكنز كريه الرائحة يبقى كنزًا!",
    "17381": "آهار! هل ظننت أنك ستفلت بهذه السهولة؟",
    "17382": "اللومباكس تقترب كثيرًا من المصلح! أسقطوها!",
    "17388": "مناصب مرموقة ذات نفوذ!",
    "17390": "اسمعوا غناءنا، ولتقرع الأجراس: دن، دن، دن... موت!",
    "17391": "متسللون أمامنا! فليبدأ الجميع بالقتل!",
    "17394": "إذًا، كيف تكون عمليات الإعدام؟ هذه أول واحدة أحضرها.",
    "17402": "إذًاااا،",
    "17404": [
      "استمع إلى أنشودتنا جيدًا،",
      "ثم أطلق النار على القراصنة بالترتيب لتعيد غناءها."
    ],
    "17406": [
      "وإذا",
      "احتجت",
      "إلى سماع الأنشودة مجددًا، فاضرب الزر الموجود على الأرض لإعادتها!"
    ],
    "17407": "عمل ممتاز حقًّا! والآن دور الرفيق الصغير!",
    "17412": "أتظن أن حنجرتك مستعدة لأنشودة ماكرة متقلبة الإيقاع؟!",
    "17413": "تمرد!",
    "17414": [
      "آه، يا له من لحن!",
      "وفي خبر آخر،",
      "أردوليس مغلقة اليوم لمناسبة خاصة:",
      "إعدام بيير لو فير!"
    ],
    "17415": [
      "سيطلق النار على كل متسلل أو يطعن فور رؤيته، وتذكروا المادة الرابعة من ميثاق القراصنة:",
      "لا تفجروا سفينتكم اللعينة بأنفسكم أبدًا."
    ],
    "17417": "متسللون؟! لن توقفوا يد العدالة السريعة، أيها...",
    "17420": "سيختارني الرئيس يومًا ما للقتال في الساحة. آه، يومًا ما...",
    "17421": [
      "من المؤسف أن حانة زوركي منطقة يحظر فيها العنف.",
      "هناك سفن جميلة كثيرة تنتظر من يستولي عليها."
    ],
    "17424": [
      "مولونوث لقمة سائغة.",
      "وفيها خردة لا تكفي مئة حجرة شحن لاستيعابها."
    ],
    "17426": [
      "لقد لقنت اللومباكس فرانسوا درسًا قاسيًا في الساحة. هاها!",
      "لكنه كان يستحق ذلك نوعًا ما..."
    ],
    "17428": [
      "لطالما عرفت أن في القبطان كوانتوم شيئًا مريبًا. أم ينبغي أن أقول طريًّا؟",
      "هاها!"
    ],
    "17435": "صفوفنا تتناقص!",
    "17440": "لنجعلهم يندمون على ذلك!",
    "17452": "لن تفجرني!",
    "17453": "باونسر في الميدان، يا رفاقي!",
    "17458": "ستدفع ثمن ذلك بحياتك، أيها الحقير!",
    "17462": "احتموا!",
    "17478": "أصبتني؟!",
    "17479": "لا مكسب بلا ألم!",
    "17482": "ما رأيك بتلك الضربة؟!",
    "17484": "لن يحتملوا أكثر من ذلك!",
    "17485": "هل بعثرت فراءك؟",
    "17505": "سأدوسكم حتى تتفتتوا، أيها الحثالة!",
    "17507": "ذلك الوغد يقذف روبوتات الهلاك!",
    "17517": "سأغنم منك سلاح إنفورسر ذاك قريبًا!",
    "17519": "إنفورسر على سطح السفينة!",
    "17529": "ليذب أحد كتلة الجليد هذه!",
    "17534": "ثبت تصويبه علي!",
    "17549": "احذروا الصقيع، يا رفاقي!",
    "17551": "قضمة الصقيع لا تخيفني!",
    "17553": [
