      "همم، ربما على قبعة جديدة؟"
    ],
    "17554": "لا أطيق انتظار مغادرة الميناء. أحتاج إلى بعض الإثارة.",
    "17568": "فاجأتك، أليس كذلك؟",
    "17594": "ابقوا على الأرض، يا رفاقي!",
    "17599": "أسقطوا ذلك الدرع، يا رفاقي!",
    "17603": "سأذبحك بسيفي!",
    "17606": "استعد للجلد!",
    "17619": "يبدو أنك تحتاج إلى ذخيرة!",
    "17626": "المبكسل؟!",
    "17627": "ليساعدني أحد!",
    "17628": "لقد أصبت، يا رفاقي!",
    "17629": "لا تدعوه يحولكم إلى بكسلات، يا رفاقي!",
    "17631": "ضربة موفقة!",
    "17634": "أتحداك أن تجرب ذلك مجددًا!",
    "17645": "أي نوع من رينو هذا؟!",
    "17649": "اضربوهم بالسيوف!",
    "17650": "جهزوا أسلحتكم!",
    "17655": "سلموا القنابل!",
    "17659": "ستلتقي بطرف سيفي قريبًا!",
    "17661": "أتخاف المواجهة وجهًا لوجه؟",
    "17662": "يا إلهي! احموا رؤوسكم!",
    "17689": "من أين أتيت بمؤجج الحروب؟!",
    "17691": "لا يمكنك مواصلة إطلاق النار إلى الأبد! أم يمكنك ذلك؟",
