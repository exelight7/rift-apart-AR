  "changes": {
    "14465": "لن تصعقني بالكهرباء، يا لومباكس!",
    "14466": "احموا مصاهركم، يا أصدقاء!",
    "14471": "احذروا النيران المرتدة!",
    "14477": "أتقدم، يا أصدقاء!",
    "14491": "هاجموا العضوي ما دامت ذخيرته ناقصة!",
    "14495": [
      "لا!",
      "اجتاحتني الكائنات العضوية!"
    ],
    "14498": "ظهرت أصفاري وآحادي!",
    "14503": "لقد انبعج هيكلي!",
    "14506": "مجرد انبعاج!",
    "14513": "الانبعاجات لن توقفني!",
    "14519": "رصدت متمردًا ينبغي أسره!",
    "14522": "توقف، أيها المتمرد المحرض!",
    "14523": "قنابل يدوية قادمة!",
    "14535": "لن تردعني بهذه السهولة.",
    "14536": "يا لها من وقاحة!",
    "14545": "أبقوا دوائركم جافة، يا أصدقاء!",
    "14546": "قذائف تحت الأرض تقترب!",
    "14554": "سلم مؤجج الحروب!",
    "14559": "إلى أين تذهب؟!",
    "14563": "المجد للإمبراطور! وصلت شحنة مكعبات البروتين!",
    "14565": "دافعوا عن هذه الغرفة حتى تصل التعزيزات!",
    "14570": [
      "بالطبع، لكنني قلق مما قد يفعله أولئك المحتالون إن تركنا لهم حرية التصرف،",
      "في محطتنا."
    ],
    "14571": "أوه... ماذا لو سرقوا نسختي الأصلية المطبوعة من توقيع الإمبراطور؟",
    "14576": "عثر على روبوت المعلومات المفقود! بدء الاسترجاع!",
    "14585": "لا بد أنك متشوق *جدًّا* إلى الفناء!",
    "14587": "أصبح فناؤك الآن مؤكدًا تمامًا!",
    "14594": "أطلب دعمًا إضافيًّا للقضاء على اللومباكس نهائيًّا!",
    "14595": "لم يكن هروب اللومباكس *خطئي*!",
    "14596": "كان ينبغي أن أخدم الإمبراطور، لكن زملائي المتواضعين كلفوني بحراسة المحيط...",
    "14602": "هذا المكان سيصبح آلة حرب هائلة!",
    "14605": [
      "لا تعرف متى سيأتي أحد،",
      "ويسرق التحفة التي سرقناها بكل عناية..."
    ],
    "14607": "قلت لك إن الفخ سينجح! لا أحد يقاوم الراريتانيوم!",
    "14609": "الأعداء يجتاحوننا!",
    "14610": "من هذه المخلوقات؟ انحنوا لإمبراطوركم!",
    "14615": "سأضمن الالتزام بمواعيد التخلص من النفايات. يجب أن يكون زوردوم نظيفًا تمامًا لجلالته.",
    "14617": "أهلًا، أيها السجين! عد إلى زنزانتك لجلسة تعذيبك المسائية!",
    "14622": "أحب معالجة السجناء!",
    "14627": [
      "هل سمعت عن الاضطراب في مركز المعالجة؟",
      "أبلغت أن المتسبب ربما كان...",
      "لومباكس."
    ],
    "14632": [
      "كان جاسوسنا محقًّا!",
      "اقضوا على اللومباكس باسم إمبراطورنا!"
    ],
    "14633": "لا تدعوهم يهربون! إمبراطوركم يأمركم! بشكل غير مباشر!",
    "14649": "حياة أخرى قدمت للإمبراطور.",
    "14650": "يا لها من وقاحة!",
    "14661": "انتشروا!",
    "14663": "اخترق هيكلي!",
    "14668": "احذروا على أسلاككم!",
    "14670": "إنهم يثبتون التصويب علينا!",
    "14682": "مجرد انبعاج!",
    "14684": "شكرًا، لكن لا، شكرًا!",
    "14691": "نجحت!",
    "14732": "سلم الإنفورسر، أيها المتمرد!",
    "14738": "قد تكون الهزيمة رائعة أيضًا! سترى!",
    "14739": "هذه المعركة التي ستنتهي بموتك المحتوم ستكون مثيرة جدًّا!",
    "14744": "حمل زائد على المستشعرات!",
    "14753": "أبواغ قادمة!",
    "14794": "احذروا ذلك المصادم، يا أصدقاء!",
    "14797": "السرور كله لي!",
    "14840": "دعني أمد لك يد المساعدة!",
    "14864": "ذخيرة العضوي قليلة!",
    "14870": "مقرف! مقرف! أزيلوه عني!",
    "14875": "سأصمد.",
    "14876": "لقد تبكسلت؟!",
    "14878": "يا لها من همجية!",
    "14879": "يسهل إصلاح هذا الانبعاج!",
    "14897": "من أين جاء ذلك؟!",
    "14903": "ابتعدوا عن الشظايا، يا أصدقاء!",
    "14909": "لا يزال CPU سليمًا!",
    "14913": "لم ينته هذا الأمر بعد!",
    "14929": "من أين حصلت على مؤجج الحروب، أيها العضوي؟!",
    "14930": "نيران تثبيت قادمة!",
    "14940": "احرسوا مصدر الطاقة! لن يفاجئونا مجددًا.",
    "14943": [
      "إن كان هذا ما يقلقك، فلا تخف؛ أنا واثق بأن صاحب المجد سيسمح لك بشراء...",
      "نسخة جديدة."
    ],
    "14947": "عاد مصمما الديكور الداخلي؟!",
    "14948": "الإمبراطور يكره عصير الليمون! لا ينبغي أن يكون الشيء حامضًا وحلوًا معًا!",
    "14949": "انتشروا! الإمبراطور يريد إخضاع كل رعاياه!",
    "14954": "كيف تجرؤ على تخييب أمل الإمبراطور برفض تسليم اللومباكس!",
    "14965": "ربما يغير رأيك ذلك الحافز الممتاز... *الألم*!",
    "14971": "دخيل! يا لها من مفاجأة سارة!",
    "14972": "صدوهم من أجل الإمبراطور!",
    "14973": "أعرف! الإمبراطور يدلّلنا!",
    "14976": "نهب هذا الكوكب حق للإمبراطور نيفاريوس!",
    "14980": [
      "حقًّا؟!",
      "أوف،",
      "حسنًا."
    ],
    "14981": [
      "هذه فرصتنا...",
      "لأسره!"
    ],
    "14984": [
      "هجوم وحوش من الأحياء الأموات؟!",
      "كان طالعي صحيحًا!"
    ],
    "14990": "غير معروف... جار التحقيق.",
    "14991": "عودوا إلى زنازينكم، وإلا منعتم من دخول صالة الأوزان لعشر دورات.",
    "14992": "أخشى أنك مخطئة.",
    "14993": [
      "كلما شطبت بندًا من قائمتي، أضافت مديرة السجن خمس مهام أخرى! نحتاج إلى حديث،",
      "جاد عن «إدارة الأفراد»."
    ],
    "14995": "حسنًا، *أنا* عالجت الروبوت «كلانك»، وكان سجينًا ذا *أولوية* عالية.",
    "14997": "فرد غير مصرح له في قسم السجناء العام. لا خيار سوى تحويله إلى كومة رماد.",
    "14999": "علينا العثور على اللومباكس، باسم إمبراطورنا المحب!",
    "15007": "هنا تنتهي مقاومتك!",
    "15011": "عضو آخر في المقاومة؟ أوه، سأجعل الإمبراطور فخورًا اليوم!",
    "15014": "المقاومة هنا! هاجموا أولًا ساحتنا الموسيقية، والآن منتجعاتنا؟!",
    "15015": [
      "روبوت التجسس هنا!",
      "اقضوا على جميع المتسللين بالحزم المناسب!"
    ],
    "15030": "لن تستطيع الهرب منا إلى الأبد!"
  }
}
