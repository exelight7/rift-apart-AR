    "speaker_code": "CHEF1",
    "scene_code": "BLIZ_SQ_GAMEPLAY",
    "arabic_current": "<ts=&quot;0;2.412&quot;>هل حدث لها شيء فعلا هذه<br>المرة؟",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
