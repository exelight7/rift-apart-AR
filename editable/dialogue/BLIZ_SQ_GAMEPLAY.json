    "speaker_code": "CHEF1",
    "scene_code": "BLIZ_SQ_GAMEPLAY",
    "arabic_current": "<ts=&quot;0;3.995&quot;>إن لم تعد، ربما أستفيد من<br>...وصفاتي ولو مرة واحدة",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
