    "speaker_code": "CHEF1",
    "scene_code": "BLIZ_SQ_GAMEPLAY",
    "arabic_current": "<ts=&quot;0.023;1.958&quot;>لا بد أنني سأطلب تلك<br>.الزيادة الآن",
