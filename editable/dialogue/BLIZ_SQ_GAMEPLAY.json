    "category": "dialogue",
    "speaker_code": "CHEF1",
    "scene_code": "BLIZ_SQ_GAMEPLAY",
    "arabic_current": "<ts=&quot;0;4.5&quot;>!سيقدم الطعام بعد قليل<br>رئيسة الطهاة توليو تشكرك<br>!على صبرك",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
