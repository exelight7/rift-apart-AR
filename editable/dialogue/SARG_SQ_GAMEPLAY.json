    "category": "dialogue",
    "speaker_code": "MORT1",
    "scene_code": "SARG_SQ_GAMEPLAY",
    "arabic_current": "<ts=&quot;0.031;2.344&quot;>هل تقصد أول مرة --ها هو<br>التقينا فيها؟",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
