    "category": "dialogue",
    "speaker_code": "MORT1",
    "scene_code": "SARG_SQ_GAMEPLAY",
    "arabic_current": "<ts=&quot;0;4.384&quot;>عودي إلى مصنع<br>الجيلاتونيوم حتى نشكرك<br>!شخصيا",
