  {
    "index": 12768,
    "key": "MON4_SAVA_SQ_GAMEPLAY_001",
    "category": "dialogue",
    "speaker_code": "MON4",
    "scene_code": "SAVA_SQ_GAMEPLAY",
    "arabic_current": "<ts=&quot;0;1.819&quot;>حصلت على اللورب؟<ts=&quot;3.3;4.2&quot;>!يا سلام<ts=&quot;4.64;8.84&quot;>الآن تستطيع الاستماع إلى<br>.ما سجل عليها",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
