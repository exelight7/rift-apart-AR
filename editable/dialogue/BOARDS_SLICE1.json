    "key": "RIVE_BOARDS_SLICE1_016",
    "category": "dialogue",
    "speaker_code": "RIVE",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "نقاتل طريقنا خارج السجن<br>.ونعود إلى حانة زوركيز",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
