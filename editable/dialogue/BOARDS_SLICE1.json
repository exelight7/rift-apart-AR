    "category": "dialogue",
    "speaker_code": "RIVE",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "ومع كل حلفائنا، نذهب إلى<br>كورسون الخامسة لمواجهة<br>.مارلوري",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
