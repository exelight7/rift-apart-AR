[
  {
    "index": 18976,
    "key": "RATC_BOARDS_SLICE1_001",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "هنا على كورسون الخامسة<br>وما !نحتفل بالوحدة الكونية<br>أفضل من الاحتفال بعربات<br>:مزينة تكريما لأبطال المجرة<br>!أنا وكلانك",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18977,
    "key": "RATC_BOARDS_SLICE1_002",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "بينما أنا وكلانك مشغولان<br>بمقاتلة نيفاريوس، تصدم<br>عربتنا حقل طاقة غريبا<br>يحيط بالبرج فيقذفنا<br>.أميالا بعيدا",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18978,
    "key": "RATC_BOARDS_SLICE1_003",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "يستيقظ كلانك تالفا وسط<br>يلقى لومباكس .الأنقاض<br>ينادي .أنا، من بعد آخر ...أخرى<br>.»ريفت« تلك اللومباكس",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18979,
    "key": "RATC_BOARDS_SLICE1_004",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "وجدت .لم أكن محظوظا مثله<br>نفسي أصرخ وحيدا في<br>الظلام، في نسخة روبوتية<br>لا .من كورسون الخامسة<br>مسدسات، لا كلانك، ولا فكرة<br>.عن كيف وصلت إلى هنا أصلا<br>الآن علي فقط أن أعرف كيف<br>.أعود إلى البيت",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18980,
    "key": "RATC_BOARDS_SLICE1_005",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "أجد الإمبراطور نيفاريوس<br>ومساعدته الروبوتية مالوري<br>واقفين حول الشيء الذي بدأ<br>—كل هذه الفوضى البعدية<br>.جهاز يدعى الريموت الكوني",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18981,
    "key": "RATC_BOARDS_SLICE1_006",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "بعد أن سيطر على بعده<br>سئم، والإمبراطور نيفاريوس<br>بمساعدة .يريد المزيد<br>الريموت الكوني العبقري<br>الذي صنعته مارلوري،<br>يستطيع الإمبراطور هدم<br>الجدران بين الأبعاد،<br>والاستيلاء على بعدنا<br>!تاليا",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18982,
    "key": "RATC_BOARDS_SLICE1_007",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "أهرع :تخطر لي فكرة عبقرية<br>...وأحطم الريموت بمفتاحي<br>ويبدو أن ريفت خطرت لها<br>الفكرة نفسها في بعدها في<br>.الوقت نفسه",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18983,
    "key": "RATC_BOARDS_SLICE1_008",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "لكن حين لمسته نحن الاثنان<br>!في اللحظة نفسها، انفجر<br>فطار كل منا وطارت معه شظايا<br>.الريموت عبر كلا البعدين",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18984,
    "key": "RATC_BOARDS_SLICE1_009",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "ما يعني في حالتي أنني<br>هبطت مباشرة في مدينة<br>نيفاريوس، حيث ألقى جنود<br>الإمبراطور نيفاريوس القبض<br>.علي فورا",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18985,
    "key": "RATC_BOARDS_SLICE1_010",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "انتهى بي المطاف مرميا على<br>.سفينة نقل إلى سجن زردوم",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18986,
    "key": "RATC_BOARDS_SLICE1_011",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "محظوظون، رفيقي في الزنزانة<br>يكره الإمبراطور نيفاريوس<br>.بقدر ما أكرهه",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18987,
    "key": "RATC_BOARDS_SLICE1_012",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "بقليل من الإقناع،<br>يساعدني على سرقة طراد<br>وكان .شرطة والهرب من هناك<br>...الأمر رائعا",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18988,
    "key": "RATC_BOARDS_SLICE1_013",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "حتى وجدت نفسي أطير بلا ...<br>هدف وحيدا، ومعي قطعة<br>»كلانك« معدنية سميتها<br>.كمساعد طيار",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18989,
    "key": "RATC_BOARDS_SLICE1_014",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "ولذلك حين عرض إعلان عن مكان<br>اسمه حانة زوركيز ومجمع<br>المذابح، توجهت مباشرة إلى<br>.هناك",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18990,
    "key": "RATC_BOARDS_SLICE1_015",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "لكن .انطلقت إلى سافالي<br>حين وصلت، اكتشفت أنني<br>لست الوحيد الذي يبحث عن<br>مساعدة .قطعة الريموت<br>الإمبراطور نيفاريوس،<br>.مارلوري، كانت هناك هي الأخرى",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18991,
    "key": "RATC_BOARDS_SLICE1_016",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "تخبرني أنها تكره العمل عند<br>الإمبراطور نيفاريوس وتحاول<br>.منعه من تنفيذ خطته",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18992,
    "key": "RATC_BOARDS_SLICE1_017",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "فقلت في نفسي، عدو عدوي<br>صديقي، صحيح؟ ثم نحن<br>.نستفيد من مساعدة بعضنا<br>بقوتي وذكائها، نحن زوج<br>أمسكنا القطعة وغادرنا !مثالي<br>.الكوكب معا",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18993,
    "key": "RATC_BOARDS_SLICE1_018",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "في الأثناء، تطير ريفت<br>وكلانك إلى سارجاسو للظفر<br>بغلاف الريموت قبل أن يصل<br>.إليها نيفاريوس",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18994,
    "key": "RATC_BOARDS_SLICE1_019",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "تشرح مارلوري أن البلورة<br>النادرة التي استخدمت<br>بطارية للريموت توجد على<br>.كوكب بليزار برايم",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18995,
    "key": "RATC_BOARDS_SLICE1_020",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "حين وصلنا اكتشفنا أن<br>نيفاريوس حطم الكوكب لئلا<br>يستطيع أحد أن يفعل،<br>بالضبط ما نفعله ...حسنا<br>.نحن",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18996,
    "key": "RATC_BOARDS_SLICE1_021",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "محظوظون نحن، الكوكب مخترق<br>بشقوق إلى بعدي أنا حيث<br>.الكوكب في حالة مثالية",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18997,
    "key": "RATC_BOARDS_SLICE1_022",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "جمعنا البلورات التي نحتاجها<br>.وتوجهنا إلى وجهتنا التالية",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18998,
    "key": "RATC_BOARDS_SLICE1_023",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "أنا ومارلوري توقفنا عند كوكب<br>مولونوث للحصول على<br>مساعدة في إعادة تجميع<br>.الريموت",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 18999,
    "key": "RATC_BOARDS_SLICE1_024",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "بكل ما نحتاج لإنهاء الريموت،<br>أنا ومارلوري هبطنا في محطة<br>كيدارو للعثور على مصدر<br>حان وقت .الطاقة لتشغيله<br>.إنهاء هذا",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 19000,
    "key": "RATC_BOARDS_SLICE1_025",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "أثناء معركتنا ضد الإمبراطور<br>نيفاريوس، أرمي الريموت إلى<br>!تشغله فينجح الأمر .مارلوري",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 19001,
    "key": "RATC_BOARDS_SLICE1_026",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "وحينها تشرح مالوري أنها ...<br>.ستتبنى خطته لنفسها<br>لكن هذه المرة من أجل<br>»القضية النبيلة«<br>.المتمثلة في جمع الجميع<br>واثقة أنها ستنجح، .كروبوتات<br>ولن تسمح لأحد بالوقوف في<br>.طريقها",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 19002,
    "key": "RATC_BOARDS_SLICE1_027",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "أحاول أن أردعها، لكن مارلوري<br>تستخدم الريموت لإرسالي<br>.عائدا إلى حانة زوركيز",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 19003,
    "key": "RATC_BOARDS_SLICE1_028",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "مع اختفاء الريموت ومارلوري<br>المتحصنة في كورسون<br>الخامسة تجهز خططها، الأمور لا<br>نحتاج كل .تبدو جيدة<br>المساعدة الممكنة لاقتحام<br>.المكان وإيقافها",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 19004,
    "key": "RATC_BOARDS_SLICE1_029",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "علينا أنا وريفت وكلانك أن<br>نبحث في الكون عن حلفاء كي<br>نوقف مارلوري قبل أن<br>.تستولي على كل شيء",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 19005,
    "key": "RATC_BOARDS_SLICE1_030",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "حتى مع كل حلفائنا، نحتاج<br>.أسطولا لمحاربة جيش مارلوري<br>فذهبت إلى أردوليس لأطلب<br>مساعدة قراصنة الفضاء<br>.الروبوتيين",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 19006,
    "key": "RATC_BOARDS_SLICE1_031",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "ألتقي بقائدهم الذي يقول<br>.إنهم سيفعلون ما بوسعهم<br>.لكن بلا وعود قاطعة",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 19007,
    "key": "RATC_BOARDS_SLICE1_032",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "لدينا كل ما .ها قد وصلنا<br>يمكن أن نحتاجه لمجابهة<br>.مارلوري",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 19008,
    "key": "RATC_BOARDS_SLICE1_033",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "قبل أن نرحل، أنا وريفت<br>بنيت له جسدا :نفاجئ كلانك<br>جديدا بقطع سرقتها ريفت<br>.من مولونوث",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 19009,
    "key": "RATC_BOARDS_SLICE1_034",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "لنا .إنها لحظة مؤثرة فعلا<br>.جميعا",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 19010,
    "key": "RATC_BOARDS_SLICE1_035",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "لكن لا يتسع الوقت حقا<br>قوات مارلوري .للاستمتاع بها<br>لكن .تفوقنا عددا بكثير<br>تماما حين يبدو الأمل<br>...مفقودا",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 19011,
    "key": "RATC_BOARDS_SLICE1_036",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "قائد القراصنة يظهر<br>!ليتولى بقية المعركة<br>وبينما يقاتلون، نتسلل<br>.نحن إلى مدينة نيفاريوس",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 19012,
    "key": "RATC_BOARDS_SLICE1_037",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "بينما تخفت طاقة مارلوري،<br>يعود الإمبراطور نيفاريوس<br>للظهور عبر أحد الصدوع التي<br>سببها الريموت، ويشده<br>.إليه",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 19013,
    "key": "RATC_BOARDS_SLICE1_038",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "في اللحظة نفسها، يحاصر<br>.سرب من الروبوتات كلانك<br>وبينما .أركض لمحاولة إنقاذه<br>نقصي يمينا ويسارا، نعد<br>بعضنا ألا ننسى أبدا<br>.التقدير المتبادل بيننا",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
    "index": 19014,
    "key": "RATC_BOARDS_SLICE1_039",
    "category": "dialogue",
    "speaker_code": "RATC",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "نقاتل جميعا فريقا واحدا<br>ونسقط الإمبراطور نيفاريوس<br>!نهائيا وإلى الأبد",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
