    "speaker_code": "RIVE",
    "scene_code": "BOARDS_SLICE1",
    "arabic_current": "أصبحت الآن أثق أن كلانك لن<br>يغتالني، وراتشت عبر عن<br>.امتنانه لصديقه",
    "arabic_edit": "",
    "status": "todo",
    "notes": "",
    "reading_needs_review": true
  },
  {
