    "scene_code": "ZURK_G2_CINE_EMPINTRO",
    "arabic_current": "<ts=&quot;0.045;1.989&quot;>!هاهاهاهاها<ts=&quot;2.196;4.449&quot;>!يا إلهي، أي معركة كانت",
