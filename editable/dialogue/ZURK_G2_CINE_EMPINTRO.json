    "scene_code": "ZURK_G2_CINE_EMPINTRO",
    "arabic_current": "<ts=&quot;0.01;0.99&quot;>!مهلا<ts=&quot;1.307;4.165&quot;>لقد قاتلت المتمردين<br>!لسنوات<ts=&quot;4.256;7.073&quot;>!دعني أساعدك على محقتهم",
